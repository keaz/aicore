module examples.core.vec_value_semantics;
import std.io;
import std.option;
import std.vec;

// Vec values never change: operations return new vectors, and values derived
// from the same base stay independent.
fn at(v: Vec[Int], index: Int) -> Int {
    match vec.get(v, index) {
        Some(x) => x,
        None => -1,
    }
}

fn main() -> Int effects { io } capabilities { io } {
    let empty: Vec[Int] = vec.new_vec_with_capacity(8);
    let base = vec.push(empty, 1);
    let a = vec.push(base, 100);
    let b = vec.push(base, 200);
    let c = vec.set(a, 0, 7);
    print_int(at(a, 1));
    print_int(at(b, 1));
    print_int(at(a, 0));
    print_int(at(c, 0));
    print_int(vec.vec_len(base));
    0
}
