{
  "schema_version": 2,
  "warmup_runs": 1,
  "measure_runs": 7,
  "regression_tolerance_pct": 45.0,
  "regression_floor_ms": 25.0,
  "calibration": {
    "description": "Fixed pure-Python integer loop timed once per round; scales the regression limit on a slower host",
    "iterations": 4000000,
    "max_speed_factor": 2.0,
    "thresholds": {
      "linux": {
        "baseline_ms": 165.3
      },
      "macos": {
        "baseline_ms": 217.2
      },
      "windows": {
        "baseline_ms": 238.6
      }
    },
    "windows_note": "Windows does not run this gate in CI; its baselines are the Linux baselines scaled by the earlier Windows/Linux ratio per scenario. Recalibrate with --update-baseline on a Windows host before gating Windows."
  },
  "env": {
    "CARGO_TERM_COLOR": "never"
  },
  "scenarios": [
    {
      "id": "parse_pipeline_benchmark",
      "description": "Parse/typecheck/codegen benchmark gate on fixed service dataset",
      "test": "e8_perf_tests",
      "args": [
        "perf_budget_gate_passes_for_reference_dataset",
        "--exact",
        "--nocapture"
      ],
      "thresholds": {
        "linux": {
          "baseline_ms": 18.0,
          "max_ms": 150.0
        },
        "macos": {
          "baseline_ms": 22.8,
          "max_ms": 150.0
        },
        "windows": {
          "baseline_ms": 27.5,
          "max_ms": 200.0
        }
      }
    },
    {
      "id": "router_match_path_order",
      "description": "REST router match path/param ordering runtime path",
      "test": "execution_tests",
      "args": [
        "exec_router_matches_paths_params_and_order",
        "--exact",
        "--nocapture",
        "--test-threads=1"
      ],
      "thresholds": {
        "linux": {
          "baseline_ms": 1510.3,
          "max_ms": 4500.0
        },
        "macos": {
          "baseline_ms": 1566.3,
          "max_ms": 5000.0
        },
        "windows": {
          "baseline_ms": 2066.7,
          "max_ms": 6200.0
        }
      }
    },
    {
      "id": "json_runtime_hardening",
      "description": "JSON parse limits/format diagnostics deterministic runtime path",
      "test": "execution_tests",
      "args": [
        "exec_json_runtime_hardening_limits_and_format_failures_are_deterministic",
        "--exact",
        "--nocapture",
        "--test-threads=1"
      ],
      "thresholds": {
        "linux": {
          "baseline_ms": 1495.6,
          "max_ms": 4800.0
        },
        "macos": {
          "baseline_ms": 1462.8,
          "max_ms": 5600.0
        },
        "windows": {
          "baseline_ms": 2136.6,
          "max_ms": 7000.0
        }
      }
    },
    {
      "id": "async_net_lifecycle_sustained_churn",
      "description": "Async net submit/wait/cancel sustained churn soak path",
      "test": "execution_tests",
      "args": [
        "exec_runtime_net_async_lifecycle_sustained_churn_is_leak_free",
        "--exact",
        "--nocapture",
        "--test-threads=1"
      ],
      "thresholds": {
        "linux": {
          "baseline_ms": 2139.1,
          "max_ms": 5600.0
        },
        "macos": {
          "baseline_ms": 2222.2,
          "max_ms": 6000.0
        },
        "windows": {
          "baseline_ms": 2976.1,
          "max_ms": 7800.0
        }
      }
    },
    {
      "id": "async_net_multi_worker_service_load",
      "description": "Shared-queue multi-worker async net service-load path",
      "test": "execution_tests",
      "args": [
        "exec_runtime_net_async_multi_worker_service_load_is_stable",
        "--exact",
        "--nocapture",
        "--test-threads=1"
      ],
      "thresholds": {
        "linux": {
          "baseline_ms": 1518.9,
          "max_ms": 6200.0
        },
        "macos": {
          "baseline_ms": 1479.3,
          "max_ms": 7000.0
        },
        "windows": {
          "baseline_ms": 2278.4,
          "max_ms": 8600.0
        }
      }
    }
  ]
}
